# Service
# Port the API listens on. Matches the Dockerfile EXPOSE and compose healthcheck.
PORT=8000

# LLM provider
# Groq API key (equivalent role to OPENAI_API_KEY for the Groq backend).
# Obtain at https://console.groq.com/keys
GROQ_API_KEY=

# LangSmith
# LangChain / LangSmith API key for trace collection and dataset access.
# Obtain at https://smith.langchain.com under Settings > API Keys.
LANGCHAIN_API_KEY=
# Set to true to send traces to LangSmith. The app defaults to true.
LANGCHAIN_TRACING_V2=true
# LangSmith project name. Traces appear under this project in the UI.
LANGCHAIN_PROJECT=ci-gated-llm-pipeline

# Evaluation
# Model used for the pipeline (summarization and extraction inferences).
# Probe result 2026-10-03: finish_reason=stop 3/3, empty=0, think-blocks=0.
LLM_MODEL=qwen/qwen3.8-27b
# Model used by the LLM-as-judge evaluator. Same model, json_object mode.
JUDGE_MODEL=qwen/qwen3.8-27b
